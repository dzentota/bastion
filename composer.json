{
    "name": "dzentota/bastion",
    "description": "Bastion \u2014 security-first CMS. A practical proof of the AppSec Manifesto.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "bjeavons/zxcvbn-php": "^1.4",
        "dzentota/config-loader": "dev-main#9478405b980b1627540e4b3dbd76b239fbd8f868",
        "dzentota/dns-resolver": "dev-main#19b6bf4b622f363e9bb89bda0320b2414d024b5b",
        "dzentota/domain-primitives": "dev-main#ca30bd8153bade09f6803948edcfe5ef3a25e3f7",
        "dzentota/http-client": "dev-main#e78be7b732e1f4bcec56008fd985b35ad1b90cf8",
        "dzentota/identity": "dev-main#78f8d9f7c2dc205e2e9e713c44641a94ade9e6f7",
        "dzentota/respected-typedvalue": "dev-master#7f25a6b38c6346c48976fa8f8e2f63bf48da014c",
        "dzentota/router": "dev-master#7f325088def91a224309362b71576bc760a48eb3",
        "dzentota/secure-db": "dev-main#cd4e45ab893785ce9e0a455395f84eabbea23a0c",
        "dzentota/session": "dev-main#7ed23565767cc43341405d5d007b2148a4a2a698",
        "dzentota/template-engine": "dev-main#144f8ce80c1fcb36389dfeedcec2d934bd135640",
        "dzentota/template-variable": "dev-main#dbb38afe83b1d3fb4eac247c97643917adac48ee",
        "dzentota/typedvalue": "dev-master#e67df8c1cb2ae1412d683bfccfe5507edf0f40c0",
        "lbuchs/webauthn": "^2.2",
        "nikic/php-parser": "^5.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "paragonie/csp-builder": "^3.0",
        "paragonie/halite": "^5.1",
        "php-di/php-di": "^7.0",
        "spomky-labs/otphp": "^11.3",
        "symfony/mailer": "^7.3"
    },
    "require-dev": {
        "hybridtm/hybridtm": "dev-main#e031fdf2b834f712e75700c89ac8f2af9cd06070",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.29"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/router",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/session",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/identity",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/secure-db",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/ConfigLoader",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/typedvalue",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/respected-typedvalue",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/DomainPrimitives",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/template-engine",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/template-variable",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/hybridtm",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/template-variable",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/http-client",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/dzentota/dns-resolver",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "Bastion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bastion\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
