#!/usr/bin/env php
<?php
// SBOM релиза (CycloneDX 1.5, ADR-0014).
//   bin/sbom generate [--version=X] [--out=build/sbom.cdx.json]   — из composer.lock и vendor/
//   bin/sbom verify [file]                                         — сверить vendor/ с SBOM (на сервере после выкладки)
declare(strict_types=1);

use Bastion\Release\Sbom;

require dirname(__DIR__) . '/vendor/autoload.php';

if (PHP_SAPI !== 'cli') {
    exit(1);
}
$root = dirname(__DIR__);
$cmd = $argv[1] ?? '';
$opts = [];
foreach (array_slice($argv, 2) as $a) {
    if (preg_match('/^--(version|out)=(.+)$/', $a, $m)) {
        $opts[$m[1]] = $m[2];
    } else {
        $opts['file'] = $a;
    }
}
$default = $root . '/build/sbom.cdx.json';

switch ($cmd) {
    case 'generate':
        $lock = json_decode((string) file_get_contents($root . '/composer.lock'), true, 64, JSON_THROW_ON_ERROR);
        $epoch = getenv('SOURCE_DATE_EPOCH');
        $sbom = Sbom::generate($lock, $root . '/vendor', $opts['version'] ?? 'dev', is_string($epoch) && ctype_digit($epoch) ? (int) $epoch : time());
        $out = $opts['out'] ?? $default;
        if (!is_dir(dirname($out))) {
            mkdir(dirname($out), 0755, true);
        }
        file_put_contents($out, json_encode($sbom, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
        $unpinned = count(array_filter($sbom['components'], static fn (array $c) => in_array(['name' => 'bastion:unpinned-branch', 'value' => 'true'], $c['properties'] ?? [], true)));
        echo "Wrote {$out}: " . count($sbom['components']) . " components ({$unpinned} on development branches, pinned by commit).\n";
        break;
    case 'verify':
        $file = $opts['file'] ?? $default;
        $sbom = json_decode((string) file_get_contents($file), true, 64, JSON_THROW_ON_ERROR);
        $installed = json_decode((string) file_get_contents($root . '/vendor/composer/installed.json'), true, 64, JSON_THROW_ON_ERROR);
        $dev = $installed['dev-package-names'] ?? [];
        $runtime = array_values(array_diff(array_column($installed['packages'] ?? [], 'name'), $dev));
        $problems = Sbom::verify($sbom, $root . '/vendor', $runtime);
        foreach ($problems as $p) {
            fwrite(STDERR, $p . "\n");
        }
        echo $problems === [] ? "OK: vendor/ matches the SBOM.\n" : '';
        exit($problems === [] ? 0 : 2);
    default:
        echo "Usage:\n  bin/sbom generate [--version=X] [--out=FILE]\n  bin/sbom verify [FILE]\n";
        exit($cmd === '' ? 0 : 1);
}
