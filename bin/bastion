#!/usr/bin/env php
<?php
// Bastion CLI. Emergency Access (ADR-0010): доступен только тому, у кого есть shell/SSH на сервере.
declare(strict_types=1);

use Bastion\Audit\Infrastructure\HmacAuditTrail;
use Bastion\Infrastructure\Database\Connection;
use Bastion\Installation\Paths;
use Bastion\SecurityMonitoring\Domain\ActorKey;
use Bastion\SecurityMonitoring\Infrastructure\DbAppSensor;
use Bastion\Shared\Infrastructure\{FileLogger, SystemClock};

require dirname(__DIR__) . '/vendor/autoload.php';

if (PHP_SAPI !== 'cli') {
    exit(1);
}
$root = getenv('BASTION_ROOT');
$paths = new Paths(is_string($root) && $root !== '' ? $root : dirname(__DIR__));
[$cmd, $arg] = [$argv[1] ?? '', $argv[2] ?? ''];

if (!$paths->isInstalled()) {
    fwrite(STDERR, "Bastion is not installed.\n");
    exit(1);
}
$config = json_decode((string) file_get_contents($paths->config()), true, 8, JSON_THROW_ON_ERROR);
$db = $config['db']['driver'] === 'mysql'
    ? Connection::mysql($config['db']['host'], (int) $config['db']['port'], $config['db']['name'], $config['db']['user'], $config['db']['password'])
    : Connection::sqlite($paths->sqlite());
$audit = new HmacAuditTrail($db, hash_hmac('sha256', 'bastion:audit', (string) file_get_contents($paths->cacheKey()), true), $paths->auditAnchor(), new SystemClock());
$sensor = new DbAppSensor($db, new SystemClock(), new FileLogger($paths->var('log/security.log')), $audit);

switch ($cmd) {
    case 'unlock-account':
        $sensor->clear(ActorKey::account(mb_strtolower($arg)));
        $id = $db->selectCell('SELECT id FROM ?_accounts WHERE username = ?', mb_strtolower($arg));
        if (is_string($id)) {
            $sensor->clear(ActorKey::account($id));
        }
        echo "Cleared AppSensor responses for account '{$arg}'.\n";
        break;
    case 'unlock-ip':
        if (filter_var($arg, FILTER_VALIDATE_IP) === false) {
            fwrite(STDERR, "Invalid IP.\n");
            exit(1);
        }
        $sensor->clear(ActorKey::ip($arg));
        echo "Cleared AppSensor responses for IP {$arg}.\n";
        break;
    case 'reset-link':
        // Emergency Access: ссылка сброса без почты. Второй фактор после сброса по-прежнему нужен.
        $key = \ParagonIE\Halite\KeyFactory::loadEncryptionKey($paths->encryptionKey());
        $accounts = new \Bastion\IdentityAccess\Infrastructure\AccountRepository($db, $key);
        $user = \Bastion\IdentityAccess\Domain\Username::tryParse(mb_strtolower($arg), $u) ? $accounts->findByUsername($u) : null;
        if ($user === null) {
            fwrite(STDERR, "No such account.\n");
            exit(1);
        }
        $site = \Bastion\IdentityAccess\Domain\SiteUrl::fromNative($config['site']['url']);
        $reset = new \Bastion\IdentityAccess\Application\PasswordReset(
            $accounts, new \Bastion\IdentityAccess\Infrastructure\ResetTokenRepository($db), new \Bastion\Mail\UnconfiguredMailer(),
            new \Bastion\Shared\Application\AfterResponse(), $site, $sensor, $audit, new SystemClock(),
        );
        echo "One-time reset link (valid 30 minutes):\n" . $reset->issueLinkFor($user) . "\n";
        break;
    case 'audit:verify':
        $v = $audit->verify();
        echo ($v->intact ? 'OK: ' : 'TAMPERED: ') . $v->reason . " ({$v->entries} entries verified)\n";
        exit($v->intact ? 0 : 2);
    case 'migrate':
        // Догоняет схему после обновления Bastion: только CREATE ... IF NOT EXISTS, данные не трогаются.
        \Bastion\Infrastructure\Database\Schema::migrate($db, $config['db']['driver'], $paths->schemaVersion());
        echo "Schema is up to date.\n";
        break;
    case 'updates:run':
        // Автообновления расширений (ADR-0014): запускать по cron. Ничего не ставится без записи в журнале.
        try {
            foreach ((new \Bastion\Http\Kernel($paths, true))->runUpdates() as $line) {
                echo $line, "\n";
            }
        } catch (\Bastion\Updates\Domain\InvalidRecord $e) {
            fwrite(STDERR, 'Update channel refused: ' . $e->getMessage() . "\n");
            exit(2);
        }
        break;
    default:
        echo "Usage:\n  bin/bastion unlock-account <username>\n  bin/bastion unlock-ip <ip>\n  bin/bastion reset-link <username>\n  bin/bastion audit:verify\n  bin/bastion updates:run\n  bin/bastion migrate\n";
        exit($cmd === '' ? 0 : 1);
}
