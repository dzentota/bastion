#!/usr/bin/env php
<?php
// Обёртка: vendor/bin/hybridtm ищет autoload только как корневой проект.
// TODO(hybridtm): использовать $_composer_autoload_path.
declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

$app = new Symfony\Component\Console\Application('HybridTM Threat Modeler', '0.1.0');
foreach (['Analyze', 'Compile', 'Export', 'Import', 'Init', 'Normalize'] as $cmd) {
    $class = "HybridTM\\Console\\{$cmd}Command";
    $app->addCommand(new $class());
}
$app->run();
